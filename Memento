class Status:
    def __init__(self, nome):
        self.nome = nome

    def __str__(self):
        return self.nome


class Memento:
    def __init__(self, indice, status):
        self._indice = indice
        self._status = status

    def get_estado(self):
        return self._indice, self._status


class Pacote:
    def __init__(self, codigo):
        self.codigo = codigo
        self._fluxo = ["Em Processamento", "Enviado", "Entregue"]
        self._indice = 0
        self.status = Status(self._fluxo[self._indice])

    def avancar_status(self):
        if self._indice < len(self._fluxo) - 1:
            self._indice += 1
            self.status = Status(self._fluxo[self._indice])
            print(f"Pacote {self.codigo}: avançou para {self.status}")
        else:
            print("O pacote já está no status final!")

    def mostrar_status(self):
        print(f"Pacote {self.codigo} - Status atual: {self.status}")

    # salva estado atual
    def salvar(self):
        return Memento(self._indice, self.status)

    # restaura estado
    def restaurar(self, memento):
        self._indice, self.status = memento.get_estado()
        print("Estado restaurado!")


class Historico:
    def __init__(self):
        self._historico = []

    def salvar(self, memento):
        self._historico.append(memento)

    def desfazer(self):
        if self._historico:
            return self._historico.pop()
        else:
            print("Nada para desfazer!")
            return None


def menu():
    pacote = Pacote("PKG001")
    historico = Historico()

    while True:
        print("\n--- MENU ---")
        print("1 - Ver status")
        print("2 - Avançar status")
        print("3 - Desfazer última ação")
        print("0 - Sair")

        opcao = input("Escolha: ")

        if opcao == "1":
            pacote.mostrar_status()

        elif opcao == "2":
            # salva estado ANTES de alterar
            historico.salvar(pacote.salvar())
            pacote.avancar_status()

        elif opcao == "3":
            m = historico.desfazer()
            if m:
                pacote.restaurar(m)

        elif opcao == "0":
            print("Encerrando sistema...")
            break

        else:
            print("Opção inválida!")


menu()
